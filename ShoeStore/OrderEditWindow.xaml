<Window x:Class="ShoeStore.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ"
        Width="450"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="25">

        <TextBlock
            x:Name="TitleTextBlock"
            Text="Добавление заказа"
            FontSize="26"
            FontWeight="Bold"
            Margin="0,0,0,20"/>

        <TextBlock Text="Номер заказа"/>

        <TextBox
            x:Name="OrderIdTextBox"
            Height="30"
            Margin="0,5,0,15"/>

        <TextBlock Text="Дата заказа"/>

        <DatePicker
            x:Name="OrderDatePicker"
            Height="30"
            Margin="0,5,0,15"/>

        <TextBlock Text="Клиент"/>

        <ComboBox
            x:Name="ClientComboBox"
            Height="30"
            Margin="0,5,0,15"
            DisplayMemberPath="Name"
            SelectedValuePath="Id"/>

        <TextBlock Text="Пункт выдачи"/>

        <ComboBox
            x:Name="PickupComboBox"
            Height="30"
            Margin="0,5,0,15"
            DisplayMemberPath="Name"
            SelectedValuePath="Id"/>

        <TextBlock Text="Статус"/>

        <ComboBox
            x:Name="StatusComboBox"
            Height="30"
            Margin="0,5,0,25"
            DisplayMemberPath="Name"
            SelectedValuePath="Id"/>

        <StackPanel Orientation="Horizontal">

            <Button
                Content="Сохранить"
                Width="130"
                Height="40"
                Margin="0,0,10,0"
                Click="SaveOrder_Click"/>

            <Button
                Content="Отмена"
                Width="130"
                Height="40"
                Click="Cancel_Click"/>

        </StackPanel>

    </StackPanel>

</Window>
