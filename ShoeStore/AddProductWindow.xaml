<Window x:Class="ShoeStore.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар"
        Height="720"
        Width="520"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="25">

            <TextBlock
                x:Name="TitleTextBlock"
                Text="Добавление товара"
                FontSize="26"
                FontWeight="Bold"
                Margin="0,0,0,25"/>

            <StackPanel x:Name="ProductIdPanel">

                <TextBlock Text="Артикул"/>

                <TextBox
                    x:Name="ProductIdTextBox"
                    Height="30"
                    Margin="0,5,0,15"
                    IsReadOnly="True"/>

            </StackPanel>

            <TextBlock Text="Название"/>

            <TextBox
                x:Name="ProductNameTextBox"
                Height="30"
                Margin="0,5,0,15"/>

            <TextBlock Text="Описание"/>

            <TextBox
                x:Name="DescriptionTextBox"
                Height="70"
                Margin="0,5,0,15"
                AcceptsReturn="True"
                TextWrapping="Wrap"/>

            <TextBlock Text="Цена"/>

            <TextBox
                x:Name="PriceTextBox"
                Height="30"
                Margin="0,5,0,15"/>

            <TextBlock Text="Категория"/>

            <ComboBox
                x:Name="CategoryComboBox"
                Height="30"
                Margin="0,5,0,15"
                DisplayMemberPath="Name"
                SelectedValuePath="Id"/>

            <TextBlock Text="Производитель"/>

            <ComboBox
                x:Name="ManufacturerComboBox"
                Height="30"
                Margin="0,5,0,15"
                DisplayMemberPath="Name"
                SelectedValuePath="Id"/>

            <TextBlock Text="Поставщик"/>

            <ComboBox
                x:Name="SupplierComboBox"
                Height="30"
                Margin="0,5,0,15"
                DisplayMemberPath="Name"
                SelectedValuePath="Id"/>

            <TextBlock Text="Единица измерения"/>

            <TextBox
                x:Name="UnitTextBox"
                Height="30"
                Margin="0,5,0,15"
                Text="шт."/>

            <TextBlock Text="Количество на складе"/>

            <TextBox
                x:Name="StockQuantityTextBox"
                Height="30"
                Margin="0,5,0,15"/>

            <TextBlock Text="Скидка, %"/>

            <TextBox
                x:Name="DiscountTextBox"
                Height="30"
                Margin="0,5,0,15"/>

            <TextBlock Text="Изображение"/>

            <Grid Margin="0,5,0,25">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="ImagePathTextBox"
                    Grid.Column="0"
                    Height="30"
                    IsReadOnly="True"/>

                <Button
                    Grid.Column="2"
                    Content="Выбрать"
                    Width="100"
                    Height="30"
                    Click="ChooseImage_Click"/>

            </Grid>

            <StackPanel Orientation="Horizontal">

                <Button
                    Content="Сохранить"
                    Width="130"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="SaveProduct_Click"/>

                <Button
                    Content="Отмена"
                    Width="130"
                    Height="40"
                    Click="Cancel_Click"/>

            </StackPanel>

        </StackPanel>

    </ScrollViewer>

</Window>
