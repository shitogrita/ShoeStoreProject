<Window x:Class="ShoeStore.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация"
        Width="430"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="35">

        <Border
            Background="White"
            CornerRadius="10"
            Padding="30">

            <StackPanel>

                <TextBlock
                    Text="Магазин обуви"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="#0F172A"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Вход в систему"
                    FontSize="16"
                    Foreground="#64748B"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,30"/>

                <TextBlock
                    Text="Логин"
                    FontWeight="SemiBold"
                    Foreground="#334155"/>

                <TextBox
                    x:Name="LoginTextBox"
                    Height="38"
                    Margin="0,6,0,18"/>

                <TextBlock
                    Text="Пароль"
                    FontWeight="SemiBold"
                    Foreground="#334155"/>

                <PasswordBox
                    x:Name="PasswordTextBox"
                    Height="38"
                    Margin="0,6,0,25"/>

                <Button
                    Content="Войти"
                    Height="42"
                    Click="Login_Click"/>

                <Button
                    Content="Войти как гость"
                    Height="42"
                    Margin="0,12,0,0"
                    Background="#475569"
                    Click="Guest_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>
